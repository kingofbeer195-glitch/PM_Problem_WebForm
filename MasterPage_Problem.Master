<%@ master language="C#" autoeventwireup="true"
    codefile="MasterPage_Problem.master.cs" inherits="jig_tool.MasterPage_Problem" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <title>PM Problem System</title>
    <link rel="icon" href="icon/problem.png" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta charset="utf-8" />

    <link href="CSS/font-awesome.css" rel="stylesheet" />
    <link href="css/bootstrap_sum.css" rel="stylesheet" />
    <script src="Scripts/jquery-1.9.1.js"></script>

    <link href="css/w3v4.10.css" rel="stylesheet" />
    <link href="css/styles.css" rel="stylesheet" />
    <link href="DataTables-1.10.18/css/dataTables.css" rel="stylesheet" />
    <link href="Content/chosen.css" rel="stylesheet" />

    <%--JS--%>
    <script src="Scripts/script.js"></script>
    <script src="Scripts/bootstrap.min.js"></script>
    <script src="DataTables-1.10.18/js/dataTables.js"></script>
    <script src="DataTables-1.10.18/FixedColumns-3.2.5/js/fixedColumns.dataTables.js"></script>
    <script src="Scripts/chosen.jquery.js"></script>

    <%-- ============================================================
         Top Navigation (ปรับใหม่) : เมนูชิดซ้าย, Sub Menu แบบ dropdown
         - Desktop : hover เปิด sub menu
         - Mobile (<= 900px) : ปุ่ม ☰ เปิด sidebar, กดชื่อเมนูเพื่อเปิด sub menu
         ============================================================ --%>
    <style>
        :root {
            --nav-h: 56px;
            --nav-bg: #5F6F52;
            --nav-bg-dark: #4E5C43;
            --nav-hover: #6E7F60;
            --nav-accent: #E3C9A0;
            --nav-text: #FFFFFF;
            --sub-bg: #FFFFFF;
            --sub-text: #33402B;
            --sub-hover: #F1F3EC;
        }

        * {
            box-sizing: border-box;
        }

        body {
            min-height: 100vh;
            margin: 0;
            margin-top: calc(var(--nav-h) + 10px) !important;
            font-family: 'Segoe UI', Tahoma, 'Leelawadee UI', sans-serif;
        }

        /* ---------- Nav bar ---------- */
        nav.pm-nav {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            height: var(--nav-h);
            background: var(--nav-bg);
            box-shadow: 0 2px 6px rgba(0, 0, 0, .18);
            z-index: 1030;
        }

        .pm-nav .navbar-inner {
            height: 100%;
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: flex-start;
            padding: 0 16px;
            gap: 4px;
        }

        .pm-nav .logo {
            display: flex;
            align-items: baseline;
            gap: 6px;
            margin-right: 20px;
            padding-right: 20px;
            border-right: 1px solid rgba(255, 255, 255, .25);
            white-space: nowrap;
        }

            .pm-nav .logo a {
                font-size: 20px;
                font-weight: 700;
                color: var(--nav-text);
                text-decoration: none;
                letter-spacing: .3px;
            }

            .pm-nav .logo span {
                font-size: 12px;
                color: var(--nav-accent);
                text-transform: uppercase;
                letter-spacing: 1px;
            }

        .pm-nav .menu-toggle {
            display: none;
            background: none;
            border: 0;
            color: var(--nav-text);
            font-size: 20px;
            padding: 6px 10px;
            margin-right: 6px;
            cursor: pointer;
        }

        .pm-nav .nav-links {
            flex: 1;
            height: 100%;
        }

            .pm-nav .nav-links .sidebar-head {
                display: none;
            }

        .pm-nav ul.links {
            display: flex;
            align-items: stretch;
            height: 100%;
            margin: 0;
            padding: 0;
            list-style: none;
        }

            .pm-nav ul.links > li {
                position: relative;
                display: flex;
                align-items: center;
                list-style: none;
            }

                .pm-nav ul.links > li > a,
                .pm-nav ul.links > li > .menu-label {
                    display: flex;
                    align-items: center;
                    gap: 7px;
                    height: 100%;
                    padding: 0 14px;
                    color: var(--nav-text);
                    font-size: 14px;
                    font-weight: 500;
                    text-decoration: none;
                    white-space: nowrap;
                    cursor: pointer;
                    border-bottom: 3px solid transparent;
                    transition: background .15s, border-color .15s;
                }

                    .pm-nav ul.links > li > .menu-label a {
                        color: inherit;
                        text-decoration: none;
                    }

                .pm-nav ul.links > li:hover > a,
                .pm-nav ul.links > li:hover > .menu-label,
                .pm-nav ul.links > li.active > a {
                    background: var(--nav-hover);
                    border-bottom-color: var(--nav-accent);
                }

                .pm-nav ul.links > li .fa-chevron-down {
                    font-size: 10px;
                    opacity: .8;
                    transition: transform .2s;
                }

                .pm-nav ul.links > li:hover .fa-chevron-down {
                    transform: rotate(180deg);
                }

                /* ดัน user menu ไปด้านขวาสุด */
                .pm-nav ul.links > li.user-menu {
                    margin-left: auto;
                }

            /* ---------- Sub menu ---------- */
            .pm-nav ul.links .sub-menu {
                position: absolute;
                top: 100%;
                left: 0;
                min-width: 220px;
                margin: 0;
                padding: 6px 0;
                list-style: none;
                background: var(--sub-bg);
                border-radius: 0 0 6px 6px;
                border-top: 3px solid var(--nav-accent);
                box-shadow: 0 8px 20px rgba(0, 0, 0, .15);
                display: none;
                z-index: 1040;
            }

            .pm-nav ul.links > li.user-menu .sub-menu {
                left: auto;
                right: 0;
                min-width: 160px;
            }

            .pm-nav ul.links > li:hover > .sub-menu {
                display: block;
            }

            .pm-nav ul.links .sub-menu li {
                list-style: none;
            }

                .pm-nav ul.links .sub-menu li a {
                    display: block;
                    padding: 8px 18px;
                    color: var(--sub-text);
                    font-size: 13.5px;
                    text-decoration: none;
                    white-space: nowrap;
                    cursor: pointer;
                }

                    .pm-nav ul.links .sub-menu li a:hover {
                        background: var(--sub-hover);
                        color: var(--nav-bg-dark);
                    }

                .pm-nav ul.links .sub-menu li.disabled a {
                    color: #A8A8A8;
                    pointer-events: none;
                }

        /* ---------- Mobile ---------- */
        @media (max-width: 900px) {
            .pm-nav .menu-toggle {
                display: block;
            }

            .pm-nav .logo {
                border-right: 0;
            }

            .pm-nav .nav-links {
                position: fixed;
                top: 0;
                left: -290px;
                width: 280px;
                height: 100vh;
                overflow-y: auto;
                background: var(--nav-bg);
                box-shadow: 4px 0 14px rgba(0, 0, 0, .25);
                transition: left .3s ease;
                z-index: 1050;
            }

                .pm-nav .nav-links.open {
                    left: 0;
                }

                .pm-nav .nav-links .sidebar-head {
                    display: flex;
                    align-items: center;
                    justify-content: space-between;
                    height: var(--nav-h);
                    padding: 0 16px;
                    color: var(--nav-text);
                    font-weight: 700;
                    border-bottom: 1px solid rgba(255, 255, 255, .2);
                }

                    .pm-nav .nav-links .sidebar-head button {
                        background: none;
                        border: 0;
                        color: var(--nav-text);
                        font-size: 20px;
                    }

            .pm-nav ul.links {
                display: block;
                height: auto;
            }

                .pm-nav ul.links > li {
                    display: block;
                }

                    .pm-nav ul.links > li > a,
                    .pm-nav ul.links > li > .menu-label {
                        height: 46px;
                        justify-content: space-between;
                        border-bottom: 0;
                        border-left: 3px solid transparent;
                    }

                    .pm-nav ul.links > li.user-menu {
                        margin-left: 0;
                    }

                    .pm-nav ul.links > li:hover > .sub-menu {
                        display: none;
                    }

                    .pm-nav ul.links > li.sub-open > .sub-menu {
                        display: block;
                    }

                .pm-nav ul.links .sub-menu {
                    position: static;
                    box-shadow: none;
                    border-radius: 0;
                    border-top: 0;
                    background: var(--nav-bg-dark);
                }

                    .pm-nav ul.links .sub-menu li a {
                        color: #F2F2F2;
                        padding-left: 30px;
                    }

                        .pm-nav ul.links .sub-menu li a:hover {
                            background: var(--nav-hover);
                            color: #fff;
                        }

            .nav-backdrop.show {
                display: block;
            }
        }

        .nav-backdrop {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, .35);
            z-index: 1045;
        }
    </style>
    <style>
        .theme-text-color2 {
            background-color: #B99470 !important;
        }

        .disabled {
            background-color: #B7B7B7;
            pointer-events: none !important;
        }
    </style>
</head>
<body>
    <form id="form1" runat="server">
        <nav class="pm-nav">
            <div class="navbar-inner">
                <button type="button" class="menu-toggle" id="btnMenuOpen" aria-label="Open menu"><i class="fa fa-bars"></i></button>

                <div class="logo">
                    <a href="jt_problem_his_master.aspx">PM Problem</a><span>System</span>
                </div>

                <div class="nav-links" id="navLinks">
                    <div class="sidebar-head">
                        <span>PM Problem System</span>
                        <button type="button" id="btnMenuClose" aria-label="Close menu"><i class="fa fa-times"></i></button>
                    </div>

                    <ul class="links">
                        <%-- ===== Main Menu ===== --%>
                        <li><a id="A35" runat="server" href="#"><i class="fa fa-tachometer"></i>Dashboard</a></li>
                        <li><a id="A25" runat="server" href="#"><i class="fa fa-list-alt"></i>Problem Control List</a></li>
                        <li><a id="A28" runat="server" href="#"><i class="fa fa-plus-square-o"></i>Add Manual</a></li>

                        <li class="has-sub">
                            <span class="menu-label"><span><i class="fa fa-envelope-o"></i>&nbsp; Auto E-mail</span><i class="fa fa-chevron-down"></i></span>
                            <ul class="sub-menu">
                                <li><a id="A27" runat="server" visible="false">New Problem</a></li>
                                <li><a id="A4" runat="server" visible="false">Acknowledge</a></li>
                                <li class="disabled"><a id="A30" runat="server" visible="false">Problem Follow Up</a></li>
                                <li><a id="A13" runat="server" visible="false">Problem Follow Up(E-mail)</a></li>
                            </ul>
                        </li>

                        <li class="has-sub">
                            <span class="menu-label"><span><i class="fa fa-check-square-o"></i>&nbsp; Check Process</span><i class="fa fa-chevron-down"></i></span>
                            <ul class="sub-menu">
                                <li><a id="A41" runat="server" href="#">Acknowledge</a></li>
                                <li><a id="A36" runat="server" href="#">Person Incharge</a></li>
                                <li><a id="A31" runat="server" href="#">Issue Person</a></li>
                                <li><a id="A32" runat="server" href="#">Check [Tool Owner J3]</a></li>
                                <%--<li><a id="A33" runat="server" href="#">Check [J3]</a></li>--%>
                                <%--<li><a id="A34" runat="server" href="#">Approve [Mgr.]</a></li>--%>
                            </ul>
                        </li>

                        <li>
                            <span class="menu-label"><i class="fa fa-book"></i>
                                <asp:LinkButton runat="server" ID="A39" OnClick="A39_Click">Flow &amp; Manual</asp:LinkButton>
                            </span>
                        </li>

                        <%-- ===== User Menu (ขวาสุด) ===== --%>
                        <li class="has-sub user-menu">
                            <span class="menu-label"><span><i class="fa fa-user"></i>&nbsp;
                                <label id="hpl_userName" runat="server" style="margin: 0; font-weight: 500; cursor: pointer;"></label>
                            </span><i class="fa fa-chevron-down"></i></span>
                            <ul class="sub-menu">
                                <li><a id="A2" runat="server" href="#"><i class="fa fa-sign-out"></i>&nbsp; Log Out</a></li>
                            </ul>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
        <div class="nav-backdrop" id="navBackdrop"></div>

        <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
        </asp:ContentPlaceHolder>
    </form>

    <script>
        (function () {
            var navLinks = document.getElementById('navLinks');
            var backdrop = document.getElementById('navBackdrop');

            function openMenu() { navLinks.classList.add('open'); backdrop.classList.add('show'); }
            function closeMenu() { navLinks.classList.remove('open'); backdrop.classList.remove('show'); }

            document.getElementById('btnMenuOpen').onclick = openMenu;
            document.getElementById('btnMenuClose').onclick = closeMenu;
            backdrop.onclick = closeMenu;

            // Mobile : กดชื่อเมนูเพื่อเปิด/ปิด sub menu
            var labels = document.querySelectorAll('.pm-nav li.has-sub > .menu-label');
            for (var i = 0; i < labels.length; i++) {
                labels[i].addEventListener('click', function () {
                    if (window.innerWidth <= 900) this.parentNode.classList.toggle('sub-open');
                });
            }

            // ไฮไลต์เมนูของหน้าปัจจุบัน
            var page = (location.pathname.split('/').pop() || '').toLowerCase();
            var anchors = document.querySelectorAll('.pm-nav ul.links > li > a');
            for (var j = 0; j < anchors.length; j++) {
                var href = (anchors[j].getAttribute('href') || '').split('?')[0].split('/').pop().toLowerCase();
                if (page && href === page) anchors[j].parentNode.classList.add('active');
            }
        })();
    </script>
</body>
</html>
